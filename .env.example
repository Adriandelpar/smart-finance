# Copia este fichero a .env y rellénalo. El .env NUNCA se sube a git.

# Secreto de la integración de Notion (notion.so/profile/integrations).
# Si lo dejas vacío, la web arranca con datos de ejemplo.
NOTION_TOKEN=

# Opcional. Déjalo vacío para usarla en local sin contraseña.
# Ponla si algún día publicas la web en internet.
APP_PASSWORD=

# Opcional. Clave para firmar la cookie de sesión; si está vacía se genera una
# al arrancar (y tendrás que volver a entrar tras cada reinicio).
SECRET_KEY=

# Opcional. En qué dirección del portátil escucha la web (por defecto 127.0.0.1,
# solo el propio portátil). Para entrar desde el móvil:
#   - con Tailscale: la IP de Tailscale del portátil (sale con `tailscale ip -4`,
#     empieza por 100.). Solo tus dispositivos de Tailscale llegarán.
#   - en la wifi de casa: 0.0.0.0 (cualquiera de tu red llega: pon APP_PASSWORD).
ESCUCHAR_EN=
